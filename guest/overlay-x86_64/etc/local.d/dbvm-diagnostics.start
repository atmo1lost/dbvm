#!/bin/sh
# The QEMU backend's serial console is output-only, so print the desktop's
# state there by itself once the session has had time to start.
(
	sleep 150
	{
		echo "==== dbvm diagnostics (uptime: $(cut -d' ' -f1 /proc/uptime)s)"
		for name in Xorg jwm xterm dbus-daemon; do
			for pid in $(pgrep -x "$name"); do
				echo "$name[$pid] $(grep State /proc/"$pid"/status) wchan=$(cat /proc/"$pid"/wchan)"
			done
		done
		echo "---- jwm.log"; tail -n 15 /var/log/jwm.log
		echo "---- Xorg errors"; grep -E '\((EE|WW)\)' /var/log/Xorg.0.log | tail -n 10
		echo "---- startx.log"; grep -v '^\s*(' /var/log/startx.log | tail -n 8
		echo "---- load"; cat /proc/loadavg
		echo "==== end diagnostics"
	} > /dev/ttyS0 2>&1
) &
