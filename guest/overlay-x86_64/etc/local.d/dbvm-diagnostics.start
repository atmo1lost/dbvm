#!/bin/sh
# The QEMU backend's serial console is output-only, so print the guest's state
# there by itself: networking early, the desktop once it has had time to start.
(
	{
		echo "==== dbvm network check (uptime: $(cut -d' ' -f1 /proc/uptime)s)"
		ip -4 addr show eth0 2>&1 | grep -E 'inet|does not exist'
		ip route | head -n 2
		cat /etc/resolv.conf
		if wget -q -T 30 -O /dev/null https://dl.flathub.org/repo/summary.idx; then
			echo "flathub: reachable over HTTPS"
		else
			echo "flathub: NOT reachable"
		fi
		echo "==== end network check"
	} > /dev/ttyS0 2>&1

	sleep 120
	{
		echo "==== dbvm diagnostics (uptime: $(cut -d' ' -f1 /proc/uptime)s)"
		for name in Xorg X jwm xterm dbus-daemon; do
			for pid in $(pgrep -x "$name"); do
				echo "$name[$pid] $(grep State /proc/"$pid"/status) wchan=$(cat /proc/"$pid"/wchan)"
			done
		done
		echo "---- jwm.log"; tail -n 15 /var/log/jwm.log
		echo "---- Xorg errors"; grep -E '\((EE|WW)\)' /var/log/Xorg.0.log | grep -v FBIOPUTCMAP | tail -n 10
		echo "---- entropy"; cat /proc/sys/kernel/random/entropy_avail
		echo "---- load"; cat /proc/loadavg
		echo "==== end diagnostics"
	} > /dev/ttyS0 2>&1

	{
		echo "==== flatpak check"
		timeout 600 flatpak remote-ls --system flathub --app --columns=application 2>&1 | head -n 5
		echo "flatpak remotes: $(flatpak remotes --system --columns=name 2>&1 | tr '\n' ' ')"
		echo "==== end flatpak check"
	} > /dev/ttyS0 2>&1
) &
