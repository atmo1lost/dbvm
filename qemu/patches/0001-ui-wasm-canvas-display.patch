diff --git a/ui/wasm.c b/ui/wasm.c
new file mode 100644
index 0000000..21f4abe
--- /dev/null
+++ b/ui/wasm.c
@@ -0,0 +1,175 @@
+/*
+ * Browser canvas display for QEMU built with Emscripten ("-display wasm").
+ *
+ * QEMU keeps rendering into its usual DisplaySurface. On every display
+ * refresh the surface is converted to RGBA into a buffer in wasm memory,
+ * and a frame counter is bumped. The page reads the buffer straight out of
+ * the shared wasm memory and draws it on a <canvas>.
+ *
+ * Input goes the other way: the page pushes events into a small lock-free
+ * ring (single producer: the browser main thread; single consumer: QEMU's
+ * main loop), which is drained on the same refresh tick with the BQL held.
+ *
+ * The WasmDisplayInfo layout and event codes are a contract with dbvm's
+ * src/machine/QemuMachine.ts.
+ *
+ * SPDX-License-Identifier: GPL-2.0-or-later
+ */
+
+#include "qemu/osdep.h"
+#include "qemu/module.h"
+#include "ui/console.h"
+#include "ui/input.h"
+#include "ui/qemu-pixman.h"
+#include <emscripten.h>
+
+enum {
+    WASM_EV_KEY = 1,    /* a = QEMU key number (PC set 1, 0x80|code if E0), b = down */
+    WASM_EV_ABS = 2,    /* a = x, b = y, in surface pixels */
+    WASM_EV_BTN = 3,    /* a = InputButton, b = down */
+};
+
+typedef struct {
+    int32_t type, a, b;
+} WasmInputEvent;
+
+typedef struct {
+    uint32_t frame;     /* bumped after each completed copy into rgba */
+    uint32_t width;
+    uint32_t height;
+    uint32_t rgba;      /* address of width*height*4 bytes, R,G,B,A order */
+} WasmDisplayInfo;
+
+#define RING_SIZE 1024  /* power of two */
+
+static WasmDisplayInfo info;
+static pixman_image_t *rgba_image;
+static DisplaySurface *surface;
+static bool dirty;
+
+static WasmInputEvent ring[RING_SIZE];
+static uint32_t ring_head;  /* written by the page */
+static uint32_t ring_tail;  /* written by QEMU */
+
+EMSCRIPTEN_KEEPALIVE WasmDisplayInfo *dbvm_display_info(void)
+{
+    return &info;
+}
+
+EMSCRIPTEN_KEEPALIVE int dbvm_input_push(int type, int a, int b)
+{
+    uint32_t head = __atomic_load_n(&ring_head, __ATOMIC_RELAXED);
+    uint32_t tail = __atomic_load_n(&ring_tail, __ATOMIC_ACQUIRE);
+
+    if (head - tail >= RING_SIZE) {
+        return 0;
+    }
+    ring[head % RING_SIZE] = (WasmInputEvent) { type, a, b };
+    __atomic_store_n(&ring_head, head + 1, __ATOMIC_RELEASE);
+    return 1;
+}
+
+static void drain_input(QemuConsole *con)
+{
+    uint32_t head = __atomic_load_n(&ring_head, __ATOMIC_ACQUIRE);
+    uint32_t tail = ring_tail;
+    bool pointer = false;
+
+    for (; tail != head; tail++) {
+        WasmInputEvent *ev = &ring[tail % RING_SIZE];
+
+        switch (ev->type) {
+        case WASM_EV_KEY:
+            qemu_input_event_send_key_number(con, ev->a, ev->b);
+            break;
+        case WASM_EV_ABS:
+            if (info.width && info.height) {
+                qemu_input_queue_abs(con, INPUT_AXIS_X, ev->a, 0, info.width);
+                qemu_input_queue_abs(con, INPUT_AXIS_Y, ev->b, 0, info.height);
+                pointer = true;
+            }
+            break;
+        case WASM_EV_BTN:
+            if (ev->a >= 0 && ev->a < INPUT_BUTTON__MAX) {
+                qemu_input_queue_btn(con, ev->a, ev->b);
+                pointer = true;
+            }
+            break;
+        }
+    }
+    __atomic_store_n(&ring_tail, tail, __ATOMIC_RELEASE);
+    if (pointer) {
+        qemu_input_event_sync();
+    }
+}
+
+static void wasm_gfx_update(DisplayChangeListener *dcl, int x, int y, int w, int h)
+{
+    dirty = true;
+}
+
+static void wasm_gfx_switch(DisplayChangeListener *dcl, DisplaySurface *new_surface)
+{
+    int w, h;
+
+    surface = new_surface;
+    if (!surface) {
+        return;
+    }
+    w = surface_width(surface);
+    h = surface_height(surface);
+    if (!rgba_image || w != info.width || h != info.height) {
+        if (rgba_image) {
+            qemu_pixman_image_unref(rgba_image);
+        }
+        rgba_image = pixman_image_create_bits(PIXMAN_a8b8g8r8, w, h, NULL, w * 4);
+        info.rgba = (uint32_t)(uintptr_t)pixman_image_get_data(rgba_image);
+        info.width = w;
+        info.height = h;
+    }
+    dirty = true;
+}
+
+static void wasm_refresh(DisplayChangeListener *dcl)
+{
+    drain_input(dcl->con);
+    graphic_hw_update(dcl->con);
+
+    if (!dirty || !surface || !rgba_image) {
+        return;
+    }
+    dirty = false;
+    /* Converts any guest pixel format to RGBA, alpha forced opaque. */
+    pixman_image_composite(PIXMAN_OP_SRC, surface->image, NULL, rgba_image,
+                           0, 0, 0, 0, 0, 0, info.width, info.height);
+    __atomic_add_fetch(&info.frame, 1, __ATOMIC_RELEASE);
+}
+
+static const DisplayChangeListenerOps wasm_dcl_ops = {
+    .dpy_name       = "wasm",
+    .dpy_gfx_update = wasm_gfx_update,
+    .dpy_gfx_switch = wasm_gfx_switch,
+    .dpy_refresh    = wasm_refresh,
+};
+
+static DisplayChangeListener wasm_dcl = {
+    .ops = &wasm_dcl_ops,
+};
+
+static void wasm_display_init(DisplayState *ds, DisplayOptions *opts)
+{
+    wasm_dcl.con = qemu_console_lookup_by_index(0);
+    register_displaychangelistener(&wasm_dcl);
+}
+
+static QemuDisplay qemu_display_wasm = {
+    .type = DISPLAY_TYPE_WASM,
+    .init = wasm_display_init,
+};
+
+static void register_wasm(void)
+{
+    qemu_display_register(&qemu_display_wasm);
+}
+
+type_init(register_wasm);
