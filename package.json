    "image": "sh tools/build-image.sh"
  },
  "dependencies": {
    "@xterm/xterm": "^6.0.0",
    "v86": "^0.5.472",
    "xterm-pty": "^0.10.1"
  },
  "devDependencies": {
    "@types/ws": "^8.18.2",
    "typescript": "^7.0.2",
    "vite": "^8.3.5",
    "ws": "^8.22.0"
  }
}
